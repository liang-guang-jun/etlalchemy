# Copy to "docker/.env" (git-ignored) and adjust as needed.
# These are the defaults baked into docker/docker-compose.yml.

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=etlalchemy
POSTGRES_PASSWORD=etlalchemy
POSTGRES_DB=etlalchemy
POSTGRES_PORT=55432

# Convenience for the app and tests.
DATABASE_URL=postgresql://etlalchemy:etlalchemy@localhost:55432/etlalchemy
TEST_DATABASE_URL=postgresql://etlalchemy:etlalchemy@localhost:55432/etlalchemy_test
